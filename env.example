# ── Required ──────────────────────────────────────────────────────────────────
# Your Bright Data API key. Get it from:
# https://brightdata.com/cp/setting/users → Generate API key
BRIGHTDATA_API_TOKEN=your_brightdata_api_key_here

# Password to protect the /setup wizard
SETUP_PASSWORD=changeme

# ── OpenClaw paths (leave as-is for Railway; change for local dev) ─────────────
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace

# Port (Railway injects this automatically; set manually for local testing)
PORT=8080

# ── Optional: Bright Data zone overrides ──────────────────────────────────────
# Leave blank to let the plugin auto-create zones on first use.
# Set these only if you want to reuse existing Bright Data zones.
BRIGHTDATA_UNLOCKER_ZONE=mcp_unlocker
BRIGHTDATA_BROWSER_ZONE=mcp_browser

# ── Optional: Set Bright Data as the default web search provider ─────────────
# Set to "true" to route all agent web searches through Bright Data.
BRIGHTDATA_AS_DEFAULT_SEARCH=false
